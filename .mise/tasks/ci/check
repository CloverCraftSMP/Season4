#!/usr/bin/env bash
#MISE description="Checks the pack is release-ready: version placeholder, server jar pin and packwiz index"
set -euo pipefail

source "$MISE_LIB/toml.helper.sh"
source "$MISE_LIB/logger.sh"

cd "$MISE_PROJECT_ROOT"

failed=0
fail() {
    log_error "$@"
    failed=1
}

if ! grep -q '^version = "@modpack_version@"$' pack.toml; then
    fail 'pack.toml must keep version = "@modpack_version@", releases substitute it'
fi

load_toml_vars "pack.toml" "MC_VERSION:minecraft" "FABRIC_VERSION:fabric"
load_toml_vars "fabric-server.pw.toml" "SERVER_JAR_URL:url"
if [[ "$SERVER_JAR_URL" != *"/loader/${MC_VERSION}/${FABRIC_VERSION}/"* ]]; then
    fail "fabric-server.pw.toml is not pinned to Minecraft ${MC_VERSION} / Fabric ${FABRIC_VERSION}." \
        "Update its url, then run 'mise run packwiz:refresh-server' and 'mise run packwiz:refresh'"
fi

# A typo'd [metafile] key is silently ignored by unsup, which then installs that mod for everyone.
while read -r slug; do
    if [[ ! -f "mods/$slug.pw.toml" && ! -f "resourcepacks/$slug.pw.toml" ]]; then
        fail "unsup.toml [metafile] lists '$slug', but there is no mods/$slug.pw.toml or resourcepacks/$slug.pw.toml"
    fi
done < <(awk '/^\[/ { in_meta = ($0 == "[metafile]"); next } in_meta && /^[A-Za-z0-9_-]+[[:space:]]*=/ { sub(/[[:space:]]*=.*/, ""); print }' unsup.toml)

if ! mise run --quiet perms:offduty --check; then
    failed=1
fi

if ! mise run --quiet motd:generate --check; then
    failed=1
fi

before="$(sha256sum index.toml pack.toml)"
packwiz refresh >/dev/null
if [[ "$(sha256sum index.toml pack.toml)" != "$before" ]]; then
    fail "index.toml was out of date. It has been refreshed, commit the result"
fi

if ((failed)); then
    exit 1
fi
log_info "Pack checks passed"
