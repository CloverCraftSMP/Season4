#!/usr/bin/env bash
#MISE description="Updates mods and generates a PR body for GitHub Actions"
set -euo pipefail

mkdir -p .ci

echo "Running packwiz update..."
mise run update > .ci/update_log.txt 2>&1

cat .ci/update_log.txt

echo "This PR was auto-generated by the \`Packwiz\` update task." > .ci/pr_body.md
echo "" >> .ci/pr_body.md
echo "### Packwiz Update Log" >> .ci/pr_body.md
echo '```text' >> .ci/pr_body.md

sed 's/\x1b\[[0-9;]*m//g' .ci/update_log.txt >> .ci/pr_body.md

echo '```' >> .ci/pr_body.md