#!/usr/bin/env bash
#MISE description="Updates all mods and writes a PR body to run/ci/pr_body.md"
set -euo pipefail

OUT="$PACKDEV_RUN_ROOT/ci"
mkdir -p "$OUT"

mise run packwiz:update-mods 2>&1 | tee "$OUT/update_log.txt"
sed 's/\x1b\[[0-9;]*m//g' "$OUT/update_log.txt" >"$OUT/clean_log.txt"

{
    echo "This PR was auto-generated by the \`Packwiz\` update task."
    echo
    echo "### Updated Mods"
    echo
    if grep -q -- "->" "$OUT/clean_log.txt"; then
        grep -- "->" "$OUT/clean_log.txt" | sed 's/^/- /'
    else
        echo "*No mods were updated.*"
    fi
    echo
    echo "<details>"
    echo "<summary><b>View full update log (Warnings & Skipped)</b></summary>"
    echo
    echo '```text'
    cat "$OUT/clean_log.txt"
    echo '```'
    echo "</details>"
} >"$OUT/pr_body.md"
