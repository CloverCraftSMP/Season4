#!/usr/bin/env bash
#MISE description="Updates mods and generates a PR body for GitHub Actions"
set -euo pipefail

mkdir -p .ci

echo "Running packwiz update..."
mise run packwiz:update-mods > .ci/update_log.txt 2>&1

cat .ci/update_log.txt

sed 's/\x1b\[[0-9;]*m//g' .ci/update_log.txt > .ci/clean_log.txt

{
  echo "This PR was auto-generated by the \`Packwiz\` update task."
  echo ""
  echo "### Updated Mods"
  echo ""

  if grep -q "\->" .ci/clean_log.txt; then
    grep "\->" .ci/clean_log.txt | sed 's/^/- /'
  else
    echo "*No mods were updated.*"
  fi
  
  echo ""
  
  echo "<details>"
  echo "<summary><b>View full update log (Warnings & Skipped)</b></summary>"
  echo ""
  echo '```text'
  cat .ci/clean_log.txt
  echo '```'
  echo "</details>"
  
} > .ci/pr_body.md