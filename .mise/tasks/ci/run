#!/usr/bin/env bash
#MISE description="Serves the pack in the background and runs the server boot test against it"
set -euo pipefail

source "$MISE_LIB/server.helper.sh"

cd "$MISE_PROJECT_ROOT"
packwiz serve >/dev/null 2>&1 &
PACKWIZ_PID=$!
trap 'kill "$PACKWIZ_PID" 2>/dev/null || true' EXIT

for _ in {1..10}; do
    packwiz_is_serving && break
    sleep 1
done
require_packwiz_serving

mise run server:test
