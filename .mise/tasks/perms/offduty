#!/usr/bin/env bash
#MISE description="Regenerates the LuckPerms offduty group from communityrep/staff/dev. Pass --check to only verify it's up to date."
set -euo pipefail

source "$MISE_LIB/logger.sh"

cd "$MISE_PROJECT_ROOT/mods/luckperms/toml-storage/groups"

# Vanilla commands every normal player can use. offduty denies minecraft.*, so these are granted back.
PLAYER_COMMANDS=(help list me msg tell w teammsg tm trigger)

# Prints every node set to true in the given group files.
granted() {
    awk '
        /^permission = / { node = $3; gsub(/"/, "", node) }
        /^value = true/ && node != "" { print node; node = "" }
        /^value = false/ { node = "" }
    ' "$@" | sort -u
}

perm() {
    printf '[[permissions]]\npermission = "%s"\nvalue = %s\n\n' "$1" "$2"
}

generate() {
    cat <<'EOF'
# GENERATED by 'mise run perms:offduty' from communityrep/staff/dev. Don't edit by hand.
# Add this group to staff, community reps or devs who want to play as a normal player.
# Its weight (100) beats every other group, so each "false" below switches off a node they
# would otherwise inherit, leaving them with exactly what the default group gets.

name = "offduty"

# [[meta]]
# key = "discord-role-id"
# value = ""

EOF
    perm "weight.100" true
    echo "# Everything communityrep, staff and dev grant (except what default already has)"
    echo
    # An offduty player still inherits default, so leave its nodes alone. Weights and display names aren't powers.
    comm -23 <(granted communityrep.toml staff.toml dev.toml) <(granted default.toml) |
        grep -vE '^(weight\.|displayname\.)' |
        while read -r node; do perm "$node" false; done
    echo "# minecraft.* is denied above, so grant back the vanilla commands normal players have"
    echo
    for cmd in "${PLAYER_COMMANDS[@]}"; do perm "minecraft.command.$cmd" true; done
}

out="$(generate)"
if [[ "${1:-}" == "--check" ]]; then
    if [[ "$out" != "$(cat offduty.toml)" ]]; then
        log_error "offduty.toml is out of date with communityrep/staff/dev. Run 'mise run perms:offduty' and commit the result"
        exit 1
    fi
    exit 0
fi
printf '%s\n' "$out" >offduty.toml
log_info "Wrote $(grep -c 'value = false' offduty.toml) denials to offduty.toml"
