#!/usr/bin/env bash
#MISE description="Downloads and caches the Fabric server jar matching pack.toml"
set -o pipefail

source "$MISE_LIB/toml.helper.sh"

load_toml_vars "pack.toml" \
    "MC_VERSION:minecraft" \
    "FABRIC_VERSION:fabric"
log_debug "Loaded in variables from toml" "Minecraft Version: $MC_VERSION" "Fabric Version: $FABRIC_VERSION"

INSTALLER_VERSION="1.0.1"
SERVER_JAR_CACHE=".mise/fabric-server-${MC_VERSION}-${FABRIC_VERSION}.jar"

if [ ! -f "$SERVER_JAR_CACHE" ]; then
	echo "Downloading Fabric Server $FABRIC_VERSION for MC $MC_VERSION..."
	mkdir -p .mise
	curl -sLo "$SERVER_JAR_CACHE" "https://meta.fabricmc.net/v2/versions/loader/${MC_VERSION}/${FABRIC_VERSION}/${INSTALLER_VERSION}/server/jar"
else
	echo "Fabric server jar already cached at $SERVER_JAR_CACHE"
fi
