#!/usr/bin/env bash
#MISE description="Downloads and caches the Fabric server jar matching pack.toml"
set -euo pipefail

source "$MISE_LIB/toml.helper.sh"
source "$MISE_LIB/logger.sh"

load_toml_vars "pack.toml" \
    "MC_VERSION:minecraft" \
    "FABRIC_VERSION:fabric"

INSTALLER_VERSION="1.0.1"
JAR="$MISE_ROOT/cache/fabric-server-${MC_VERSION}-${FABRIC_VERSION}.jar"

if [[ -f "$JAR" ]]; then
    log_info "Fabric server jar already cached at $JAR"
    exit 0
fi

log_info "Downloading Fabric server $FABRIC_VERSION for Minecraft $MC_VERSION..."
mkdir -p "$(dirname "$JAR")"
curl -sSfL -o "$JAR.part" "https://meta.fabricmc.net/v2/versions/loader/${MC_VERSION}/${FABRIC_VERSION}/${INSTALLER_VERSION}/server/jar"
mv "$JAR.part" "$JAR"
