#!/usr/bin/env bash
#MISE description="Stages a fresh server in run/server, syncing mods from the local packwiz server"
#MISE depends=["clean:server", "server:setup-jar"]
set -euo pipefail

source "$MISE_LIB/toml.helper.sh"
source "$MISE_LIB/server.helper.sh"
source "$MISE_LIB/client-build.helper.sh"

require_packwiz_serving

load_toml_vars "pack.toml" \
    "MC_VERSION:minecraft" \
    "FABRIC_VERSION:fabric"

mkdir -p "$PACKDEV_SERVER_ROOT"
echo "eula=true" >"$PACKDEV_SERVER_ROOT/eula.txt"

cp "$MISE_ROOT/cache/fabric-server-${MC_VERSION}-${FABRIC_VERSION}.jar" "$PACKDEV_SERVER_ROOT/fabric-server.jar"
fetch_unsup "$PACKDEV_SERVER_ROOT/unsup.jar"

cat <<INI >"$PACKDEV_SERVER_ROOT/unsup.ini"
version=1
preset=minecraft

source_format=packwiz
source=${PACKWIZ_LOCAL_URL}
INI

log_info "Syncing server mods..."
cd "$PACKDEV_SERVER_ROOT"
java -jar unsup.jar server
