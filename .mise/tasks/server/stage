#!/usr/bin/env bash
#MISE description="Stages the Minecraft server environment for boot"
#MISE depends=["server:setup-jar"]
#MISE wait_for=["clean"]
set -o pipefail

source "$MISE_PROJECT_ROOT/.mise/tasks/_common.sh"

ensure_server_running

SERVER_DIR=".ci/server"

mkdir -p "$SERVER_DIR"

echo "Accepting EULA..."
echo "eula=true" > "$SERVER_DIR/eula.txt"

load_pack_versions

cp ".mise/fabric-server-${MC_VERSION}-${FABRIC_VERSION}.jar" "$SERVER_DIR/fabric-server.jar"

fetch_unsup "$SERVER_DIR/unsup.jar"

echo "Configuring unsup to look at local packwiz server..."
cat << EOF > "$SERVER_DIR/unsup.ini"
version=1
preset=minecraft

source_format=packwiz
source=http://localhost:8080/pack.toml
EOF

echo "Syncing server mods..."
cd "$SERVER_DIR"
java -jar unsup.jar server