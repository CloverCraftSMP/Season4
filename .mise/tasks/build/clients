#!/usr/bin/env bash
#MISE description="Builds both .mrpack and Prism Instance .zip with Unsup"
#MISE usage="[version] [channel] [output-dir]"
set -euo pipefail

source "$MISE_PROJECT_ROOT/.mise/tasks/_common.sh"
load_pack_versions

VERSION=${1:-dev}
CHANNEL=${2:-}
OUTPUT_DIR=${3:-.}

if [[ -z "$CHANNEL" ]]; then
    case "$VERSION" in
        staging-*) CHANNEL=staging ;;
        v* | [0-9]*.[0-9]*) CHANNEL=prod ;;
        *) CHANNEL=local ;;
    esac
fi

case "$CHANNEL" in
    prod) BOOTSTRAP_URL="${REPO_BASE_RAW}/prod/pack.toml" ;;
    staging) BOOTSTRAP_URL="${REPO_BASE_RAW}/staging/pack.toml" ;;
    local) BOOTSTRAP_URL="http://localhost:8080/pack.toml" ;;
    *)
        echo "Error: unknown channel '$CHANNEL' (expected prod, staging or local)." >&2
        exit 1
        ;;
esac

mkdir -p "$OUTPUT_DIR"
OUTPUT_DIR=$(cd "$OUTPUT_DIR" && pwd)
ORIG_DIR=$(pwd)

echo "Building clients for: $VERSION (channel: $CHANNEL)"
BUILD_DIR=$(mktemp -d)
trap 'rm -rf "$BUILD_DIR"' EXIT

if command -v rsync > /dev/null; then
    rsync -a --exclude '.git' --exclude '.ci' --exclude '.mise' --exclude 'build' ./ "$BUILD_DIR"/
else
    cp -r ./. "$BUILD_DIR"/
fi

find "$BUILD_DIR/pack.toml" "$BUILD_DIR/config" -type f -exec sed -i "s/@modpack_version@/${VERSION}/g" {} +
sed -i "s|^source=.*|source=${BOOTSTRAP_URL}|" "$BUILD_DIR/unsup.ini"

cd "$BUILD_DIR"
packwiz refresh

fetch_unsup "unsup.jar"

# REGULAR MRPACK GENERATION

MRPACK_REGULAR="Season4-${VERSION}.mrpack"
packwiz modrinth export -o "$MRPACK_REGULAR"

# UNSUP MRPACK GENERATION

MRPACK_UNSUP="Season4-${VERSION}-Unsup.mrpack"
mkdir -p unsup_mrpack/overrides
cp unsup.jar unsup.ini unsup_mrpack/overrides/

cat << EOF > unsup_mrpack/modrinth.index.json
{
  "formatVersion": 1,
  "game": "minecraft",
  "versionId": "${VERSION}",
  "name": "Season 4",
  "dependencies": {
    "minecraft": "${MC_VERSION}",
    "fabric-loader": "${FABRIC_VERSION}"
  },
  "files": []
}
EOF

cd unsup_mrpack
zip -r "../$MRPACK_UNSUP" . > /dev/null
cd ..

# PRISM ZIP GENERATION (automatically includes JVM args)

PRISM_NAME="Season4-${VERSION}-Prism.zip"
PRISM_DIR="prism_temp"
mkdir -p "$PRISM_DIR/.minecraft"

cp unsup.ini "$PRISM_DIR/.minecraft/"

mkdir -p "$PRISM_DIR/patches"

cat << EOF > "$PRISM_DIR/patches/com.unascribed.unsup.json"
{
	"formatVersion": 1,
	"name": "unsup",
	"uid": "com.unascribed.unsup",
	"version": "1.2.7",
	"+agents": [
		{
			"name": "com.unascribed:unsup:1.2.7",
			"url": "https://repo.sleeping.town"
		}
	]
}
EOF

cat << EOF > "$PRISM_DIR/mmc-pack.json"
{
    "components": [
        { "important": true, "uid": "net.minecraft", "version": "${MC_VERSION}" },
        { "uid": "net.fabricmc.fabric-loader", "version": "${FABRIC_VERSION}" },
        {
            "cachedName": "unsup",
            "cachedVersion": "1.2.7",
            "uid": "com.unascribed.unsup"
        }
    ],
    "formatVersion": 1
}
EOF

cat << EOF > "$PRISM_DIR/instance.cfg"
[General]
InstanceType=OneSix
EOF

cd "$PRISM_DIR"
zip -r "../$PRISM_NAME" . > /dev/null
cd ..

cd "$ORIG_DIR"
mv -f "$BUILD_DIR/$MRPACK_REGULAR" "$BUILD_DIR/$MRPACK_UNSUP" "$BUILD_DIR/$PRISM_NAME" "$OUTPUT_DIR/"

echo "Built:"
echo " - $OUTPUT_DIR/$MRPACK_REGULAR"
echo " - $OUTPUT_DIR/$MRPACK_UNSUP"
echo " - $OUTPUT_DIR/$PRISM_NAME"