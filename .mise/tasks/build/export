#!/usr/bin/env bash
#MISE description="Exports all profiles (mrpack and serverpack) into the .ci/artifacts folder"
#MISE depends=["clean:build"]
set -euo pipefail

mkdir -p .ci/artifacts

echo "Exporting profiles via Pakku..."
mise run pakku export

echo "Organizing artifacts..."
mv build/serverpack/*.zip .ci/artifacts/
mv build/modrinth/*.mrpack .ci/artifacts/

rm -rf build
echo "Artifacts generated successfully in .ci/artifacts/"