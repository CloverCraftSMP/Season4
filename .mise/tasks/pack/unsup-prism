#!/usr/bin/env bash
set -euo pipefail

source "$MISE_LIB/toml.helper.sh"
source "$MISE_LIB/client-build.helper.sh"

build

load_toml_vars "pack.toml" \
    "MC_VERSION:minecraft" \
    "FABRIC_VERSION:fabric"
log_debug "Loaded in variables from toml" "Minecraft Version: $MC_VERSION" "Fabric Version: $FABRIC_VERSION"

fetch_unsup "unsup.jar"

BUILD_TEMP="build/tmp"
BUILD_MINECRAFT="$BUILD_TEMP/.minecraft"
BUILD_PATCHES="$BUILD_TEMP/patches"

mkdir -p "$BUILD_MINECRAFT" "$BUILD_PATCHES"

cp unsup.ini "$BUILD_MINECRAFT"

cat <<EOF >"$BUILD_PATCHES/com.unascribed.unsup.json"
{
	"formatVersion": 1,
	"name": "unsup",
	"uid": "com.unascribed.unsup",
	"version": "${UNSUP_VERSION}",
	"+agents": [
		{
			"name": "com.unascribed:unsup:${UNSUP_VERSION}",
			"url": "https://repo.sleeping.town"
		}
	]
}
EOF

cat <<EOF >"$BUILD_TEMP/mmc-pack.json"
{
    "components": [
        { "important": true, "uid": "net.minecraft", "version": "${MC_VERSION}" },
        { "uid": "net.fabricmc.fabric-loader", "version": "${FABRIC_VERSION}" },
        {
            "cachedName": "unsup",
            "cachedVersion": "${UNSUP_VERSION}",
            "uid": "com.unascribed.unsup"
        }
    ],
    "formatVersion": 1
}
EOF
log_debug "Generated mmc-pack [unsup: $UNSUP_VERSION, Minecraft: $MC_VERSION, Fabric: $FABRIC_VERSION]"

cat <<EOF >"$BUILD_TEMP/instance.cfg"
[General]
InstanceType=OneSix
EOF

cd "$BUILD_TEMP"
zip -r "$PACKDEV_BUILD_ROOT/prism-unsup-${PACKDEV_VERSION}-${PACKDEV_CHANNEL}.zip" . >/dev/null
log_debug "Generated mrpack for channel $PACKDEV_CHANNEL"

cleanup